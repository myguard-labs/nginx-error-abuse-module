/*
 * Copyright (C) 2026 Thijs Eilander
 * SPDX-License-Identifier: BSD-2-Clause
 * Real nginx pool lifecycle; only the helper's two fallible API calls are
 * fault-injected. An earlier observer runs after the secret cleanups and
 * before nginx frees either small or large pool allocations.
 */
#include <ngx_config.h>
#include <ngx_core.h>

static int fail_cleanup, fail_buffer;
static unsigned observed;

static void
require(int ok, const char *message)
{
    if (!ok) {
        fprintf(stderr, "FAIL: %s\n", message);
        exit(1);
    }
}

/* Logging is irrelevant to the pool lifecycle oracle. */
void
ngx_log_error_core(ngx_uint_t level, ngx_log_t *log, ngx_err_t err,
    const char *fmt, ...)
{
    (void) level; (void) log; (void) err; (void) fmt;
}

void
ngx_log_debug_core(ngx_log_t *log, ngx_err_t err, const char *fmt, ...)
{
    (void) log; (void) err; (void) fmt;
}

static ngx_pool_cleanup_t *
test_cleanup_add(ngx_pool_t *pool, size_t size)
{
    return fail_cleanup ? NULL : ngx_pool_cleanup_add(pool, size);
}

static void *
test_pnalloc(ngx_pool_t *pool, size_t size)
{
    return fail_buffer ? NULL : ngx_pnalloc(pool, size);
}

#define ngx_pool_cleanup_add test_cleanup_add
#define ngx_pnalloc test_pnalloc
/* SECRET_HELPERS */
#undef ngx_pool_cleanup_add
#undef ngx_pnalloc

typedef struct {
    u_char *data;
    size_t len;
    u_char *neighbor;
} observer_t;

static void
observe(void *data)
{
    observer_t *o = data;
    size_t i;

    for (i = 0; i < o->len; i++) {
        require(o->data[i] == 0, "owned secret was not wiped before pool free");
    }
    require(*o->neighbor == 0x5a, "cleanup exceeded secret allocation");
    observed++;
}

static u_char *
secret(ngx_pool_t *pool, size_t len, int partial)
{
    ngx_pool_cleanup_t *cln;
    observer_t *o;
    u_char *p;

    cln = ngx_pool_cleanup_add(pool, sizeof(observer_t));
    require(cln != NULL, "observer allocation");
    o = cln->data;
    o->neighbor = ngx_pnalloc(pool, 1);
    require(o->neighbor != NULL, "neighbor allocation");
    *o->neighbor = 0x5a;
    p = ngx_http_error_abuse_secret_alloc(pool, len);
    require(p != NULL, "secret allocation");
    /* A rejected hex key may have only a prefix written and public len=0.
     * Poison the rest so the oracle requires wiping the allocation bounds. */
    memset(p, 0xa5, len);
    if (partial) {
        memset(p, 0x17, 3);
    }
    o->data = p;
    o->len = len;
    cln->handler = observe;
    return p;
}

int
main(void)
{
    ngx_log_t log;
    ngx_pool_t *old, *fresh, *failed;
    ngx_pool_cleanup_t *cln;
    u_char *current;

    memset(&log, 0, sizeof(log));
    ngx_pagesize = 4096;
    old = ngx_create_pool(1024, &log);
    fresh = ngx_create_pool(1024, &log);
    require(old != NULL && fresh != NULL, "cycle pools");
    (void) secret(old, 16, 0);       /* minimum HMAC key, small allocation */
    (void) secret(old, 8192, 0);     /* large password allocation */
    current = secret(fresh, 32, 0);
    ngx_destroy_pool(old);          /* master retires old generation */
    require(observed == 2, "old generation cleanup count");
    require(current[0] == 0xa5 && current[31] == 0xa5,
            "reload wiped active generation");
    ngx_destroy_pool(fresh);        /* worker exit/active cycle teardown */
    require(observed == 3, "active generation cleanup count");

    failed = ngx_create_pool(1024, &log);
    require(failed != NULL, "failed config pool");
    (void) secret(failed, 16, 1);    /* invalid hex after decoded prefix */
    ngx_destroy_pool(failed);
    require(observed == 4, "partial decode cleanup count");

    failed = ngx_create_pool(1024, &log);
    require(failed != NULL, "fault pool");
    fail_cleanup = 1;
    require(ngx_http_error_abuse_secret_alloc(failed, 16) == NULL,
            "cleanup allocation failure accepted");
    require(failed->cleanup == NULL, "failed cleanup was registered");
    fail_cleanup = 0;
    fail_buffer = 1;
    require(ngx_http_error_abuse_secret_alloc(failed, 16) == NULL,
            "buffer allocation failure accepted");
    cln = failed->cleanup;
    require(cln != NULL && cln->handler == NULL,
            "failed buffer armed an invalid cleanup");
    fail_buffer = 0;
    (void) secret(failed, 1, 0);     /* smallest nonempty Redis password */
    ngx_destroy_pool(failed);
    require(observed == 5, "post-failure cleanup count");
    puts("OK: secret cleanup, reload generations, partial decode, allocation failures");
    return 0;
}
