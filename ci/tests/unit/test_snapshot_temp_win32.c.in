#include <stdlib.h>
#include <stdio.h>
#include <string.h>
#include <wchar.h>
typedef unsigned char u_char;
typedef unsigned long DWORD;
typedef void *HANDLE;
typedef wchar_t WCHAR;
typedef void *PSECURITY_DESCRIPTOR;
typedef struct { int nLength; void *lpSecurityDescriptor; int bInheritHandle; }
    SECURITY_ATTRIBUTES;
typedef struct { DWORD dwFileAttributes; DWORD nNumberOfLinks; }
    BY_HANDLE_FILE_INFORMATION;
typedef HANDLE ngx_fd_t;
typedef int ngx_int_t;
typedef unsigned int ngx_uint_t;
typedef int ngx_log_t;
#define NGX_INVALID_FILE ((HANDLE) -1)
#define NGX_ERROR (-1)
#define NGX_AGAIN (-2)
#define NGX_LOG_ERR 3
#define FALSE 0
#define SDDL_REVISION_1 1
#define ERROR_ALREADY_EXISTS 183
#define ERROR_SHARING_VIOLATION 32
#define ERROR_ACCESS_DENIED 5
#define INVALID_FILE_ATTRIBUTES ((DWORD) -1)
#define FILE_ATTRIBUTE_DIRECTORY 16
#define FILE_ATTRIBUTE_REPARSE_POINT 1024
#define GENERIC_READ 1
#define GENERIC_WRITE 2
#define DELETE 4
#define FILE_SHARE_DELETE 4
#define CREATE_NEW 1
#define OPEN_EXISTING 3
#define FILE_FLAG_OPEN_REPARSE_POINT 8
static int scenario, directory_errors;
static DWORD last_error, logged_error;
#define GetLastError() last_error
#define ngx_set_errno(err) (last_error = (err))
#define ngx_free free
#define LocalFree free
#define CloseHandle(fd) ((void) (fd))
#define DeleteFileW(path) ((void) (path))
#define ngx_log_error(level, log, err, ...) \
    ((void) (directory_errors++, logged_error = (err)))
static WCHAR *ngx_http_error_abuse_win32_utf16(u_char *path, ngx_log_t *log)
{
    (void) path; (void) log;
    return malloc(4 * sizeof(WCHAR));
}
static int ConvertStringSecurityDescriptorToSecurityDescriptorW(
    const WCHAR *text, int revision, PSECURITY_DESCRIPTOR *descriptor, void *size)
{
    (void) text; (void) revision; (void) size;
    *descriptor = malloc(1);
    return *descriptor != NULL;
}
static int CreateDirectoryW(WCHAR *dir, SECURITY_ATTRIBUTES *sa)
{
    (void) dir; (void) sa;
    last_error = scenario == 1 ? ERROR_ACCESS_DENIED : ERROR_ALREADY_EXISTS;
    return scenario == 0;
}
static DWORD GetFileAttributesW(WCHAR *dir)
{
    (void) dir;
    return FILE_ATTRIBUTE_DIRECTORY
           | (scenario == 4 ? FILE_ATTRIBUTE_REPARSE_POINT : 0);
}
static HANDLE CreateFileW(WCHAR *path, int access, int sharing,
    SECURITY_ATTRIBUTES *sa, int create, int flags, void *template)
{
    (void) path; (void) access; (void) sharing; (void) sa;
    (void) create; (void) flags; (void) template;
    last_error = scenario == 2 ? ERROR_SHARING_VIOLATION : ERROR_ACCESS_DENIED;
    return scenario == 2 || scenario == 3 ? NGX_INVALID_FILE : (HANDLE) 1;
}
static int GetFileInformationByHandle(HANDLE fd, BY_HANDLE_FILE_INFORMATION *info)
{
    (void) fd;
    info->dwFileAttributes = 0;
    info->nNumberOfLinks = scenario == 5 ? 2 : 1;
    return 1;
}

/* PRODUCTION_WINDOWS_LEASE */

int main(int argc, char **argv)
{
    ngx_int_t status;
    ngx_uint_t fresh;
    HANDLE fd;
    if (argc != 2) { return 2; }
    scenario = atoi(argv[1]);
    fd = ngx_http_error_abuse_win32_temp_lease((u_char *) "directory",
        (u_char *) "owner", &fresh, &status, NULL);
    if ((fd == NGX_INVALID_FILE) != (scenario >= 1 && scenario <= 5)
        || fresh != (scenario == 0)
        || status != (scenario == 2 ? NGX_AGAIN : NGX_ERROR)
        || directory_errors != (scenario == 1)
        || (scenario == 1 && logged_error != ERROR_ACCESS_DENIED))
    {
        fputs("FAIL: Windows lease error classification or diagnostic\n", stderr);
        return 3;
    }
    return 0;
}
