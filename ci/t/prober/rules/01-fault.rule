# Slab fault injection -- the zone-full paths that are otherwise unreachable.
#
# ngx_http_error_abuse_create_node() has three ordered outcomes when the slab
# is exhausted: a bounded expire() then retry (PERF-2), a force-evict loop then
# retry (SEC-1), and finally NGX_ERROR. Filling a real 1m zone honestly would
# take thousands of distinct identities, which a loopback harness cannot
# produce. Arming the allocator to fail on demand reaches those branches in one
# request.
#
# `fault` issues a probe request that arms the counter, then the case's own
# request trips it. Arming resets the counter, so nth is relative to the case.

# Disarm first: rules share one server, and a fault left armed by an earlier
# file would make everything after it fail in a way that looks unrelated.
name    disarm any inherited slab fault
send    GET /__probe?fault_slab=-1 HTTP/1.1\r\n
send    Host: prober\r\nConnection: close\r\n\r\n
expect  status=200
probe   zone.fault.slab_nth == -1

# The arming key is matched as a whole query argument. A parameter that merely
# ENDS in the key name must not reach the injector: the fault sites are the one
# part of the harness that can change how the module behaves, so the way in has
# to be exact rather than approximate.
name    a lookalike query parameter does not arm the injector
send    GET /__probe?not_fault_slab=3 HTTP/1.1\r\n
send    Host: prober\r\nConnection: close\r\n\r\n
expect  status=200
probe   zone.fault.slab_nth == -1

# Likewise a value with trailing junk is malformed, and malformed input is
# declined rather than guessed at -- arming "3" from "3junk" would mean the
# harness silently disagreed with the rule file about what was requested.
name    a trailing-junk fault value does not arm the injector
send    GET /__probe?fault_slab=3junk HTTP/1.1\r\n
send    Host: prober\r\nConnection: close\r\n\r\n
expect  status=200
probe   zone.fault.slab_nth == -1

# Baseline: a fresh identity is tracked normally, so the later zone-full cases
# are measured against a known node count rather than an assumed one.
name    a new identity is tracked when the allocator is healthy
from    127.0.0.11
send    GET /counted HTTP/1.1\r\n
send    Host: prober\r\nConnection: close\r\n\r\n
expect  status=502
probe   zone.nodes == 1

# on_full=allow (the default): with every node allocation failing, record()
# returns NGX_ERROR and the F-3 branch passes the response through UNTRACKED.
# The client still sees the upstream 502 -- the module does not convert a
# bookkeeping failure into a rejection under this policy.
#
# `from` is load-bearing. Nodes are keyed on the identity ($binary_remote_addr
# here), so a request from an address an earlier case already tracked would
# find its node and never allocate: the armed fault would sit untouched and the
# case would pass for the wrong reason. A fresh source address forces the
# allocation.
#
# nth is a THRESHOLD: arming at 0 fails every allocation attempt from the first
# onwards, which is what drives the ladder to exhaustion. A single-shot fault
# does NOT reach this branch -- create_node retries after the bounded expire()
# and the retry succeeds against a slab that is not really full. Measured:
# fault_slab=0 under one-shot semantics gave slab_seen=2 and a created node.
name    zone-full passes the response through under on_full=allow
from    127.0.0.12
fault   fault_slab=0
send    GET /counted HTTP/1.1\r\n
send    Host: prober\r\nConnection: close\r\n\r\n
expect  status=502
probe   zone.fault.slab_seen >= 1

# The failed allocation must not have left a partial node behind. The count is
# still 0: the baseline identity above was created and then evicted by the
# force-evict loop (SEC-1) while the faulted request tried to make room for
# itself, so nothing from either request survives.
name    a failed slab allocation records no node
send    GET /__probe HTTP/1.1\r\n
send    Host: prober\r\nConnection: close\r\n\r\n
expect  status=200
probe   zone.nodes == 0

# The retry ladder must actually have been walked, not short-circuited. With
# nothing reclaimable the module makes two allocation attempts: the first call
# and the retry after the bounded expire() (PERF-2). The force-evict loop
# (SEC-1) adds no further attempt here because it finds nothing evictable --
# every node in the zone is recent and unblocked-but-live, so
# evict_one_unblocked() returns false and the while loop never runs a retry.
# Asserting > 1 distinguishes "the ladder ran" from "the first failure returned
# straight away", which is the difference PERF-2 exists to make.
name    the retry ladder makes more than one allocation attempt
send    GET /__probe HTTP/1.1\r\n
send    Host: prober\r\nConnection: close\r\n\r\n
expect  status=200
probe   zone.fault.slab_seen > 1

name    disarm and confirm the allocator recovers
send    GET /__probe?fault_slab=-1 HTTP/1.1\r\n
send    Host: prober\r\nConnection: close\r\n\r\n
expect  status=200
probe   zone.fault.slab_nth == -1

# Same address, no fault: the identity it failed to track earlier is tracked
# now. This is the negative control for the case above -- if this did NOT add a
# node, the earlier "no node recorded" assertion would be passing because the
# address was never trackable, not because the fault suppressed it.
name    the same identity is tracked once the fault is cleared
from    127.0.0.12
send    GET /counted HTTP/1.1\r\n
send    Host: prober\r\nConnection: close\r\n\r\n
expect  status=502
probe   zone.nodes == 1
