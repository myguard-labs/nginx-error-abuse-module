*.o
*.so
*.gcda
*.gcno
.build/
__pycache__/
build/
objs/
ci/fuzz/generated_parser.inc
ci/fuzz/fuzz_*
!ci/fuzz/fuzz_*.c
!ci/fuzz/fuzz_*.dict
ci/fuzz/crash-*
ci/fuzz/minimized/
# Test::Nginx runtime tree (regenerated per run)
ci/t/servroot/
# ci/tests/unit/run.sh's build output (source and run.sh stay tracked)
ci/tests/unit/test_scan
ci/tests/unit/test_time
# fuzzer-discovered corpus entries are regenerated locally; the curated seed
# inputs (descriptively named, e.g. ci/fuzz/corpus/one_record.bin) stay tracked,
# while these wildcards keep newly discovered hash-named inputs out of git.
ci/fuzz/corpus/**
!ci/fuzz/corpus/**/
!ci/fuzz/corpus/**/*.bin
ci/fuzz/corpus_*/**
!ci/fuzz/corpus_*/**/
!ci/fuzz/corpus_*/**/*.bin
!ci/fuzz/corpus_statuses/*[!0-9a-f]*
ci/tests/unit/test_stats
