ngx_addon_name=ngx_http_error_abuse_module
ngx_module_type=HTTP_FILTER
ngx_module_name=ngx_http_error_abuse_module
ngx_module_srcs="$ngx_addon_dir/src/ngx_http_error_abuse_module.c \
                 $ngx_addon_dir/src/ngx_http_error_abuse_scan.c \
                 $ngx_addon_dir/src/ngx_http_error_abuse_win32.c"
ngx_module_incs="$ngx_addon_dir/src ${NGX_ERROR_ABUSE_INCS:-}"
ngx_module_deps="$ngx_addon_dir/src/ngx_http_error_abuse_scan.h \
                 $ngx_addon_dir/src/ngx_http_error_abuse_win32.h"
if test -n "${NGX_ERROR_ABUSE_LIBS:-}"; then
    ngx_module_libs="$NGX_ERROR_ABUSE_LIBS"
elif [ "${NGX_PLATFORM:-}" = win32 ]; then
    case "${NGX_CC_NAME:-}" in
        clang | gcc)
            ngx_module_libs="-lhiredis -lhiredis_ssl -lssl -lcrypto \
                             -lcrypt32 -ladvapi32 -lws2_32"
            ;;
        *)
            ngx_module_libs="hiredis.lib hiredis_ssl.lib libssl.lib \
                             libcrypto.lib crypt32.lib advapi32.lib ws2_32.lib"
            ;;
    esac
else
    ngx_module_libs="-lhiredis -lhiredis_ssl -lcrypto"
fi
ngx_module_order="$ngx_module_name \
                  ngx_http_headers_filter_module \
                  ngx_http_copy_filter_module"

. auto/module
