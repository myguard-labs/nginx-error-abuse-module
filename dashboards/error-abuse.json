{
  "__inputs": [
    {
      "name": "datasource",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "Error abuse by zone",
  "uid": "error-abuse-zone",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "nginx",
    "error-abuse"
  ],
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "zone",
        "label": "Zone",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(error_abuse_requests_total, zone)",
        "query": {
          "query": "label_values(error_abuse_requests_total, zone)",
          "refId": "zone"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests Total",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(error_abuse_requests_total{zone=~\"${zone}\"}[$__rate_interval])",
          "legendFormat": "{{instance}} / {{zone}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Matched Responses Total",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(error_abuse_matched_responses_total{zone=~\"${zone}\"}[$__rate_interval])",
          "legendFormat": "{{instance}} / {{zone}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Blocked Total",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(error_abuse_blocked_total{zone=~\"${zone}\"}[$__rate_interval])",
          "legendFormat": "{{instance}} / {{zone}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Dry Run Would Block Total",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(error_abuse_dry_run_would_block_total{zone=~\"${zone}\"}[$__rate_interval])",
          "legendFormat": "{{instance}} / {{zone}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Bans Total",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(error_abuse_bans_total{zone=~\"${zone}\"}[$__rate_interval])",
          "legendFormat": "{{instance}} / {{zone}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Zone Evictions Total",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(error_abuse_zone_evictions_total{zone=~\"${zone}\"}[$__rate_interval])",
          "legendFormat": "{{instance}} / {{zone}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Zone Alloc Failures Total",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(error_abuse_zone_alloc_failures_total{zone=~\"${zone}\"}[$__rate_interval])",
          "legendFormat": "{{instance}} / {{zone}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Zone Nodes",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "error_abuse_zone_nodes{zone=~\"${zone}\"}",
          "legendFormat": "{{instance}} / {{zone}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Blocked Clients",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "error_abuse_blocked_clients{zone=~\"${zone}\"}",
          "legendFormat": "{{instance}} / {{zone}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Zone Used Bytes",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "error_abuse_zone_used_bytes{zone=~\"${zone}\"}",
          "legendFormat": "{{instance}} / {{zone}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Zone Size Bytes",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "error_abuse_zone_size_bytes{zone=~\"${zone}\"}",
          "legendFormat": "{{instance}} / {{zone}}"
        }
      ]
    }
  ]
}
